<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Varunraj &amp; Janani | Wedding Invitation</title>
    <meta name="description" content="Join Varunraj &amp; Janani as they begin their forever. Wedding ceremony on 30 August 2026 at Chellam Mahal, Erode, and reception on 06 September 2026 at Babu Mahal Palace, Vellore." />
    <meta name="theme-color" content="#F8F3EA" />

    <!-- Open Graph -->
    <meta property="og:title" content="Varunraj &amp; Janani | Wedding Invitation" />
    <meta property="og:description" content="Two hearts, one beautiful journey. Celebrate with us on 30 August 2026." />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Cormorant+SC:wght@500;600&family=Parisienne&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
            /* ============================================================
               DESIGN TOKENS
               ============================================================ */
            :root{
              --ivory:#FBF7EF;
              --ivory-deep:#F5EEDF;
              --beige:#EFE3CD;
              --champagne:#C6A15B;
              --champagne-light:#E7D2A0;
              --champagne-pale:#F3E6C8;
              --sage:#8DA07C;
              --sage-deep:#5F7350;
              --sage-pale:#DCE4D2;
              --ink:#3B3226;
              --ink-soft:#6B5F4E;
              --white:#FFFFFF;
              --line:rgba(59,50,38,0.12);
              --gold-foil: linear-gradient(120deg,#B5893F 0%,#E9CE93 28%,#8C6B2E 52%,#EFD9A3 72%,#B5893F 100%);

              --font-display:'Cormorant Garamond', serif;
              --font-sc:'Cormorant SC', serif;
              --font-script:'Parisienne', cursive;
              --font-body:'Jost', sans-serif;

              --space-xs: clamp(0.5rem, 0.6vw, 0.75rem);
              --space-sm: clamp(1rem, 1.5vw, 1.5rem);
              --space-md: clamp(2rem, 3.5vw, 3.5rem);
              --space-lg: clamp(3.5rem, 7vw, 7rem);
              --space-xl: clamp(5rem, 10vw, 10rem);

              --max-w: 1180px;
              --radius: 2px;
            }

            *,*::before,*::after{box-sizing:border-box;}
            html{scroll-behavior:smooth;}
            @@media (prefers-reduced-motion: reduce){
              html{scroll-behavior:auto;}
              *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important;}
            }

            body{
              margin:0;
              background:var(--ivory);
              color:var(--ink);
              font-family:var(--font-body);
              font-weight:300;
              line-height:1.6;
              -webkit-font-smoothing:antialiased;
              overflow-x:hidden;
            }
            body.no-scroll{overflow:hidden; height:100vh;}

            img,svg{display:block; max-width:100%;}
            a{color:inherit; text-decoration:none;}
            button{font-family:inherit; cursor:pointer;}
            :focus-visible{outline:2px solid var(--champagne); outline-offset:3px;}

            .wrap{
              max-width:var(--max-w);
              margin:0 auto;
              padding-left:clamp(1.25rem, 5vw, 3rem);
              padding-right:clamp(1.25rem, 5vw, 3rem);
            }

            /* ============================================================
               TEXTURE / BACKDROP
               ============================================================ */
            .grain{
              position:fixed; inset:0; pointer-events:none; z-index:2; opacity:0.035; mix-blend-mode:multiply;
              background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
            }

            /* ============================================================
               TYPOGRAPHY
               ============================================================ */
            .eyebrow{
              font-family:var(--font-sc);
              font-size:0.78rem;
              letter-spacing:0.42em;
              text-transform:uppercase;
              color:var(--champagne);
              display:inline-flex;
              align-items:center;
              gap:0.9em;
            }
            .eyebrow::before,.eyebrow::after{content:'';width:28px;height:1px;background:var(--champagne);opacity:0.6;}

            h1,h2,h3{
              font-family:var(--font-display);
              font-weight:400;
              margin:0;
              color:var(--ink);
            }
            .section-title{
              font-size:clamp(2.1rem, 4.4vw, 3.4rem);
              font-weight:400;
              letter-spacing:0.01em;
            }
            .script{
              font-family:var(--font-script);
              font-weight:400;
              color:var(--champagne);
            }
            .lead{
              font-family:var(--font-display);
              font-style:italic;
              font-weight:400;
              font-size:clamp(1.1rem,1.6vw,1.35rem);
              color:var(--ink-soft);
            }

            /* ============================================================
               REVEAL ON SCROLL
               ============================================================ */
            .reveal{
              opacity:0;
              transform:translateY(28px);
              transition:opacity 1s cubic-bezier(.22,1,.36,1), transform 1s cubic-bezier(.22,1,.36,1);
            }
            .reveal.in{opacity:1; transform:translateY(0);}
            .reveal-delay-1{transition-delay:.12s;}
            .reveal-delay-2{transition-delay:.24s;}
            .reveal-delay-3{transition-delay:.36s;}

            /* ============================================================
               NAVIGATION
               ============================================================ */
            .nav{
              position:fixed; top:0; left:0; right:0; z-index:60;
              padding:1.5rem 0;
              border-bottom:1px solid transparent;
              transition:background .5s ease, padding .5s ease, box-shadow .5s ease, backdrop-filter .5s ease, border-color .5s ease;
            }
            .nav.scrolled{
              padding:0.9rem 0;
              background:rgba(251,247,239,0.78);
              backdrop-filter:blur(16px) saturate(150%);
              -webkit-backdrop-filter:blur(16px) saturate(150%);
              border-bottom-color:var(--line);
              box-shadow:0 12px 30px -22px rgba(59,50,38,0.35);
            }
            .nav-inner{display:flex; align-items:center; justify-content:space-between; gap:1rem;}

            .nav-mark{
              display:inline-flex; align-items:center; gap:0.5em;
              font-family:var(--font-sc);
              font-size:clamp(1rem,1.6vw,1.2rem);
              letter-spacing:0.16em;
              color:var(--ink);
              flex-shrink:0;
              transition:opacity .3s ease;
            }
            .nav-mark:hover{opacity:0.75;}
            .nav-mark .heart-mark{width:0.62em; height:0.62em; color:var(--champagne); flex-shrink:0;}
            .nav-mark .heart-mark svg{width:100%; height:100%; display:block;}

            .nav-links{
              display:flex; align-items:center;
              gap:clamp(1.5rem,2.6vw,2.6rem);
              list-style:none; margin:0; padding:0;
            }
            .nav-links a{
              font-size:0.78rem;
              letter-spacing:0.15em;
              text-transform:uppercase;
              color:var(--ink-soft);
              position:relative;
              padding-bottom:6px;
              transition:color .35s ease;
              white-space:nowrap;
            }
            .nav-links a:hover, .nav-links a:focus-visible{color:var(--ink);}
            .nav-links a::after{
              content:''; position:absolute; left:0; bottom:0; width:0; height:1px; background:var(--champagne);
              transition:width .4s cubic-bezier(.22,1,.36,1);
            }
            .nav-links a:hover::after, .nav-links a:focus-visible::after{width:100%;}

            /* Hamburger — hidden on desktop, shown below the nav breakpoint */
            .hamburger{
              display:none; flex-direction:column; align-items:center; justify-content:center;
              gap:5px; width:42px; height:42px;
              background:rgba(255,255,255,0.5);
              border:1px solid var(--champagne-light);
              border-radius:50%;
              padding:0; z-index:70; flex-shrink:0;
              transition:background .3s ease, transform .3s ease;
            }
            .hamburger:hover{background:rgba(255,255,255,0.85);}
            .hamburger span{width:16px; height:1px; background:var(--ink); transition:transform .35s ease, opacity .35s ease;}
            .hamburger.open{transform:rotate(90deg);}
            .hamburger.open span:nth-child(1){transform:translateY(6px) rotate(45deg);}
            .hamburger.open span:nth-child(2){opacity:0;}
            .hamburger.open span:nth-child(3){transform:translateY(-6px) rotate(-45deg);}

            @@media (max-width:860px){
              .nav-links{display:none;}
              .hamburger{display:flex;}
            }

            .mobile-panel{
              position:fixed; inset:0; z-index:65;
              background:linear-gradient(160deg, var(--ivory), var(--champagne-pale));
              display:flex; align-items:center; justify-content:center;
              opacity:0; visibility:hidden; transform:translateY(-12px);
              transition:opacity .45s ease, transform .45s ease, visibility 0s linear .45s;
            }
            .mobile-panel.open{opacity:1; visibility:visible; transform:translateY(0); transition:opacity .45s ease, transform .45s ease;}
            .mobile-panel-inner{text-align:center; padding:2rem;}
            .mobile-panel .mp-mark{
              display:inline-flex; align-items:center; gap:0.5em;
              font-family:var(--font-sc); letter-spacing:0.2em; font-size:1rem; color:var(--champagne);
              margin-bottom:2.6rem;
            }
            .mobile-panel .mp-mark .heart-mark{width:0.6em; height:0.6em; color:var(--champagne);}
            .mobile-panel .mp-mark .heart-mark svg{width:100%; height:100%;}
            .mobile-panel ul{list-style:none; padding:0; margin:0; text-align:center; display:flex; flex-direction:column; gap:1.9rem;}
            .mobile-panel a{
              font-family:var(--font-display); font-size:2rem; color:var(--ink); font-weight:400;
              position:relative; transition:color .3s ease;
            }
            .mobile-panel a:hover, .mobile-panel a:focus-visible{color:var(--champagne);}

            /* ============================================================
               HERO
               ============================================================ */
            .hero{
              position:relative;
              min-height:100vh;
              display:flex; align-items:center; justify-content:center;
              text-align:center;
              padding:7rem 1.5rem 4rem;
              overflow:hidden;
              background:
                radial-gradient(ellipse at 50% -10%, var(--champagne-pale) 0%, transparent 55%),
                radial-gradient(ellipse at 15% 110%, var(--sage-pale) 0%, transparent 45%),
                linear-gradient(180deg, var(--ivory) 0%, var(--ivory) 70%, var(--ivory-deep) 100%);
            }
            .hero-corner{
              position:absolute; width:clamp(160px,26vw,320px); opacity:0.9; pointer-events:none;
              animation:sway 9s ease-in-out infinite;
            }
            .hero-corner.tl{top:-18px; left:-24px;}
            .hero-corner.br{bottom:-18px; right:-24px; transform:rotate(180deg); animation-delay:1.2s;}
            @@keyframes sway{
              0%,100%{transform:translateY(0) rotate(0deg);}
              50%{transform:translateY(6px) rotate(0.6deg);}
            }
            .hero-corner.br{}
            .hero-corner.br{animation-name:swayFlip;}
            @@keyframes swayFlip{
              0%,100%{transform:rotate(180deg) translateY(0);}
              50%{transform:rotate(180deg) translateY(6px);}
            }

            .hero-content{position:relative; z-index:3; max-width:760px;}
            .hero-eyebrow, .hero-names, .hero-subtitle, .hero-date, .hero-line, .scroll-cue{
              animation-play-state:paused;
            }
            body.loaded .hero-eyebrow, body.loaded .hero-names, body.loaded .hero-subtitle,
            body.loaded .hero-date, body.loaded .hero-line, body.loaded .scroll-cue{
              animation-play-state:running;
            }

            /* ============================================================
               LANDING / INTRO LOADER
               ============================================================ */
            #loader{
              position:fixed; inset:0; z-index:999;
              display:flex; align-items:center; justify-content:center;
              background:
                radial-gradient(ellipse at 50% 40%, var(--champagne-pale) 0%, transparent 60%),
                var(--ivory);
              transition:opacity .9s cubic-bezier(.22,1,.36,1), visibility 0s linear .9s;
            }
            #loader.hide{opacity:0; visibility:hidden; pointer-events:none;}
            .loader-inner{text-align:center;}
            .loader-ring{
              position:relative; width:96px; height:96px; margin:0 auto 1.4rem;
            }
            .loader-ring svg{width:100%; height:100%; transform:rotate(-90deg);}
            .loader-ring circle{
              fill:none; stroke:var(--champagne-light); stroke-width:1;
            }
            .loader-ring .prog{
              stroke:var(--champagne); stroke-linecap:round;
              stroke-dasharray:264; stroke-dashoffset:264;
              animation:loaderProgress 2s cubic-bezier(.65,0,.35,1) forwards .15s;
            }
            @@keyframes loaderProgress{ to{ stroke-dashoffset:0; } }
            .loader-heart{
              position:absolute; inset:0; margin:auto; width:22px; height:22px; color:var(--champagne);
              opacity:0; animation:loaderHeartIn .8s ease forwards 1.5s;
            }
            .loader-heart svg{width:100%; height:100%;}
            @@keyframes loaderHeartIn{
              from{opacity:0; transform:scale(0.6);}
              to{opacity:1; transform:scale(1);}
            }
            .loader-mark{
              font-family:var(--font-sc); letter-spacing:0.5em; font-size:0.85rem; color:var(--ink-soft);
              margin:0 0 0.5rem; padding-left:0.5em;
              opacity:0; animation:fadeUp .8s ease forwards .3s;
            }
            .loader-caption{
              font-family:var(--font-display); font-style:italic; font-size:1rem; color:var(--ink-soft);
              opacity:0; animation:fadeUp .8s ease forwards .55s;
            }

            .hero-eyebrow{margin-bottom:1.6rem; opacity:0; animation:fadeUp 1s ease .3s forwards;}
            .hero-names{
              font-family:var(--font-display);
              font-weight:400;
              font-size:clamp(3rem, 9vw, 6.4rem);
              line-height:1.05;
              letter-spacing:0.01em;
              margin:0 0 0.6rem;
              opacity:0; animation:fadeUp 1.1s ease .5s forwards;
            }
            .hero-names .amp{
              width:0.56em; height:0.56em;
              color:var(--champagne);
              padding:0 0.2em;
              display:inline-block;
              vertical-align:middle;
              transform:translateY(-0.06em);
            }
            .hero-names .amp svg{width:100%; height:100%; display:block;}
            .visually-hidden{
              position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden;
              clip:rect(0,0,0,0); white-space:nowrap; border:0;
            }
            .hero-subtitle{
              font-size:0.92rem;
              letter-spacing:0.28em;
              text-transform:uppercase;
              color:var(--ink-soft);
              margin-bottom:2.2rem;
              opacity:0; animation:fadeUp 1s ease .75s forwards;
            }
            .hero-date{
              font-family:var(--font-sc);
              font-size:clamp(1.3rem, 2.6vw, 1.9rem);
              letter-spacing:0.32em;
              color:var(--champagne);
              margin-bottom:1.6rem;
              opacity:0; animation:fadeUp 1s ease .95s forwards;
            }
            .hero-line{
              font-family:var(--font-display);
              font-style:italic;
              font-size:clamp(1.05rem,1.8vw,1.3rem);
              color:var(--ink-soft);
              opacity:0; animation:fadeUp 1s ease 1.15s forwards;
            }

            @@keyframes fadeUp{
              from{opacity:0; transform:translateY(18px);}
              to{opacity:1; transform:translateY(0);}
            }

            .scroll-cue{
              position:absolute; bottom:2.2rem; left:50%; transform:translateX(-50%);
              display:flex; flex-direction:column; align-items:center; gap:0.6rem;
              z-index:3; opacity:0; animation:fadeUp 1s ease 1.6s forwards;
            }
            .scroll-cue span{
              font-size:0.68rem; letter-spacing:0.32em; text-transform:uppercase; color:var(--ink-soft);
            }
            .scroll-cue .line{
              width:1px; height:42px; background:linear-gradient(180deg, var(--champagne), transparent);
              position:relative; overflow:hidden;
            }
            .scroll-cue .line::after{
              content:''; position:absolute; top:-42px; left:0; width:100%; height:42px; background:var(--champagne);
              animation:cueDrop 2.2s ease-in-out infinite;
            }
            @@keyframes cueDrop{
              0%{top:-42px;}
              60%{top:42px;}
              100%{top:42px;}
            }

            /* ============================================================
               SECTION SHELL
               ============================================================ */
            section{position:relative; padding:var(--space-xl) 0;}
            .section-alt{background:var(--ivory-deep);}
            .section-head{text-align:center; max-width:640px; margin:0 auto var(--space-lg);}
            .section-head .section-title{margin-top:0.9rem;}
            .divider-sprig{margin:1.6rem auto 0; width:120px; opacity:0.85;}

            /* ============================================================
               COUNTDOWN
               ============================================================ */
            .countdown-section{
              background:linear-gradient(180deg, var(--ivory) 0%, var(--sage-pale) 100%);
              text-align:center;
            }
            .countdown-grid{
              display:grid; grid-template-columns:repeat(4,1fr);
              gap:clamp(0.8rem,2vw,1.6rem);
              max-width:760px; margin:0 auto;
            }
            .countdown-card{
              background:rgba(255,255,255,0.55);
              border:1px solid var(--line);
              backdrop-filter:blur(10px);
              -webkit-backdrop-filter:blur(10px);
              border-radius:var(--radius);
              padding:clamp(1.2rem,3vw,2.2rem) 0.5rem;
              position:relative;
            }
            .countdown-card::before{
              content:''; position:absolute; inset:6px; border:1px solid var(--champagne-light); pointer-events:none; opacity:0.6;
            }
            .countdown-num{
              font-family:var(--font-display); font-weight:500;
              font-size:clamp(2rem,5.5vw,3.4rem); color:var(--champagne);
              line-height:1;
            }
            .countdown-label{
              margin-top:0.6rem; font-size:0.68rem; letter-spacing:0.24em; text-transform:uppercase; color:var(--ink-soft);
            }

            /* ============================================================
               OUR STORY — TIMELINE
               ============================================================ */
            .story-timeline{position:relative; max-width:960px; margin:0 auto;}
            .story-timeline::before{
              content:''; position:absolute; left:50%; top:0; bottom:0; width:1px;
              background:linear-gradient(180deg, transparent, var(--champagne-light) 8%, var(--champagne-light) 92%, transparent);
              transform:translateX(-50%);
            }
            .story-item{
              display:grid; grid-template-columns:1fr 60px 1fr; align-items:center;
              margin-bottom:clamp(2.5rem,5vw,4.5rem);
            }
            .story-item:last-child{margin-bottom:0;}
            .story-card{
              background:var(--white);
              border:1px solid var(--line);
              padding:clamp(1.4rem,3vw,2.2rem);
              border-radius:var(--radius);
              box-shadow:0 18px 40px -28px rgba(59,50,38,0.35);
            }
            .story-photo{
              width:100%; aspect-ratio:4/3; border-radius:var(--radius); margin-bottom:1rem;
              background:linear-gradient(135deg, var(--beige), var(--sage-pale));
              display:flex; align-items:center; justify-content:center;
              color:var(--ink-soft); font-size:0.72rem; letter-spacing:0.14em; text-transform:uppercase;
              border:1px dashed var(--champagne-light);
            }
            .story-date{font-family:var(--font-sc); font-size:0.85rem; letter-spacing:0.14em; color:var(--champagne); margin-bottom:0.4rem;}
            .story-card h3{font-size:1.5rem; margin-bottom:0.5rem;}
            .story-card p{margin:0; color:var(--ink-soft); font-size:0.95rem;}
            .story-node{
              width:60px; height:60px; display:flex; align-items:center; justify-content:center; position:relative;
            }
            .story-node .dot{
              width:12px; height:12px; border-radius:50%; background:var(--champagne);
              box-shadow:0 0 0 6px var(--ivory), 0 0 0 7px var(--champagne-light);
            }
            .story-item:nth-child(odd) .story-card{grid-column:1;}
            .story-item:nth-child(odd) .spacer{grid-column:3;}
            .story-item:nth-child(even) .story-card{grid-column:3;}
            .story-item:nth-child(even) .spacer{grid-column:1;}

            @@media (max-width:760px){
              .story-timeline::before{left:22px;}
              .story-item{grid-template-columns:44px 1fr; gap:0.5rem;}
              .story-node{width:44px; grid-row:1;}
              .story-item:nth-child(odd) .story-card,
              .story-item:nth-child(even) .story-card{grid-column:2; grid-row:1;}
              .spacer{display:none;}
            }

            /* ============================================================
               VENUE CARDS (Ceremony / Reception)
               ============================================================ */
            .venue-section{}
            .venue-grid{
              display:grid; grid-template-columns:1fr 1fr; gap:clamp(1.5rem,3vw,2.5rem);
              max-width:1080px; margin:0 auto;
            }
            @@media (max-width:800px){.venue-grid{grid-template-columns:1fr;}}

            .venue-card{
              position:relative;
              padding:clamp(2.2rem,4vw,3.2rem);
              background:var(--white);
              border:1px solid var(--line);
              overflow:hidden;
            }
            .venue-card::after{
              content:''; position:absolute; top:0; left:0; right:0; height:3px; background:var(--gold-foil); background-size:200% 100%;
              animation:foilShift 6s linear infinite;
            }
            @@keyframes foilShift{0%{background-position:0% 0;}100%{background-position:200% 0;}}
            .venue-icon{width:46px; height:46px; margin-bottom:1.4rem; color:var(--champagne);}
            .venue-card .eyebrow{margin-bottom:0.9rem;}
            .venue-card h3{font-size:clamp(1.8rem,3vw,2.4rem); margin-bottom:1.1rem;}
            .venue-meta{list-style:none; margin:0 0 1.8rem; padding:0; display:flex; flex-direction:column; gap:0.65rem;}
            .venue-meta li{display:flex; gap:0.8rem; font-size:0.95rem; color:var(--ink-soft); align-items:flex-start;}
            .venue-meta li b{color:var(--ink); font-weight:500; min-width:64px; display:inline-block;}
            .btn-gold{
              display:inline-flex; align-items:center; gap:0.6rem;
              padding:0.85rem 1.9rem;
              border:1px solid var(--champagne);
              color:var(--champagne-dark, var(--ink));
              font-size:0.78rem; letter-spacing:0.16em; text-transform:uppercase;
              background:transparent; position:relative; overflow:hidden;
              transition:color .45s ease;
            }
            .btn-gold span{position:relative; z-index:2;}
            .btn-gold svg{position:relative; z-index:2; width:14px; height:14px; transition:transform .4s ease;}
            .btn-gold::before{
              content:''; position:absolute; inset:0; background:var(--gold-foil); background-size:220% 100%;
              transform:scaleX(0); transform-origin:left; transition:transform .5s cubic-bezier(.22,1,.36,1);
            }
            .btn-gold:hover{color:#2c2416;}
            .btn-gold:hover::before{transform:scaleX(1);}
            .btn-gold:hover svg{transform:translateX(4px);}

            /* ============================================================
               GALLERY
               ============================================================ */
            .gallery-masonry{
              columns:3 260px; column-gap:1.2rem; max-width:1180px; margin:0 auto;
            }
            .gallery-item{
              break-inside:avoid; margin-bottom:1.2rem; position:relative; overflow:hidden; border-radius:var(--radius);
              border:1px solid var(--line);
            }
            .gallery-item .ph{
              width:100%; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:0.6rem;
              background:linear-gradient(150deg, var(--beige), var(--champagne-pale));
              color:var(--ink-soft); font-size:0.7rem; letter-spacing:0.14em; text-transform:uppercase;
              transition:transform .7s cubic-bezier(.22,1,.36,1);
            }
            .gallery-item:nth-child(1) .ph{aspect-ratio:3/4;}
            .gallery-item:nth-child(2) .ph{aspect-ratio:1/1;}
            .gallery-item:nth-child(3) .ph{aspect-ratio:4/5;}
            .gallery-item:nth-child(4) .ph{aspect-ratio:1/1;}
            .gallery-item:nth-child(5) .ph{aspect-ratio:3/4;}
            .gallery-item:nth-child(6) .ph{aspect-ratio:4/3;}
            .gallery-item:nth-child(7) .ph{aspect-ratio:1/1;}
            .gallery-item:nth-child(8) .ph{aspect-ratio:4/5;}
            .gallery-item:nth-child(9) .ph{aspect-ratio:3/4;}
            .gallery-item .overlay{
              position:absolute; inset:0; background:linear-gradient(0deg, rgba(59,50,38,0.55), transparent 55%);
              opacity:0; transition:opacity .5s ease; display:flex; align-items:flex-end; padding:1rem;
            }
            .gallery-item .overlay span{color:#fff; font-family:var(--font-display); font-style:italic; font-size:0.95rem;}
            .gallery-item:hover .ph{transform:scale(1.07);}
            .gallery-item:hover .overlay{opacity:1;}

            /* ============================================================
               LOVE QUOTE
               ============================================================ */
            .quote-section{
              text-align:center;
              background:linear-gradient(180deg, var(--sage-pale), var(--ivory));
            }
            .quote-text{
              font-family:var(--font-script);
              font-size:clamp(2.2rem,5vw,3.6rem);
              color:var(--sage-deep);
              max-width:780px; margin:0 auto;
            }

            /* ============================================================
               EVENT TIMELINE (vertical, simple)
               ============================================================ */
            .events-list{max-width:640px; margin:0 auto; position:relative; padding-left:2.2rem;}
            .events-list::before{content:''; position:absolute; left:6px; top:6px; bottom:6px; width:1px; background:var(--champagne-light);}
            .event-row{position:relative; padding-bottom:clamp(2rem,4vw,3rem);}
            .event-row:last-child{padding-bottom:0;}
            .event-row::before{
              content:''; position:absolute; left:-2.2rem; top:4px; width:9px; height:9px; border-radius:50%;
              background:var(--champagne); box-shadow:0 0 0 4px var(--ivory);
            }
            .event-time{font-family:var(--font-sc); font-size:0.85rem; letter-spacing:0.12em; color:var(--champagne); margin-bottom:0.3rem;}
            .event-row h4{font-family:var(--font-display); font-size:1.5rem; font-weight:500; margin:0 0 0.3rem;}
            .event-row p{margin:0; color:var(--ink-soft); font-size:0.92rem;}

            /* ============================================================
               FAMILY SECTION
               ============================================================ */
            .family-grid{
              display:grid; grid-template-columns:1fr auto 1fr; gap:clamp(1.5rem,4vw,4rem);
              max-width:900px; margin:0 auto; align-items:center; text-align:center;
            }
            @@media (max-width:680px){.family-grid{grid-template-columns:1fr;}}
            .family-col h4{font-family:var(--font-sc); font-size:0.9rem; letter-spacing:0.18em; text-transform:uppercase; color:var(--champagne); margin-bottom:1.2rem;}
            .family-col p{font-family:var(--font-display); font-size:1.3rem; margin:0 0 0.5rem; color:var(--ink);}
            .family-divider{
              width:1px; height:100px; background:var(--champagne-light);
            }
            @@media (max-width:680px){.family-divider{width:60px; height:1px; margin:0.5rem auto;}}

            /* ============================================================
               FINAL SECTION
               ============================================================ */
            .final-section{
              text-align:center; padding:var(--space-xl) 0 calc(var(--space-xl) + 2rem);
              background:linear-gradient(180deg, var(--ivory-deep), var(--champagne-pale) 60%, var(--ivory));
              position:relative; overflow:hidden;
            }
            .final-title{
              font-size:clamp(2rem,5vw,3.2rem); font-style:italic; font-weight:400; max-width:640px; margin:0 auto 1.6rem;
            }
            .final-names{
              font-family:var(--font-display); font-size:clamp(2.6rem,6vw,4.6rem); color:var(--ink); margin-bottom:0.6rem;
            }
            .final-names .amp{
              width:0.62em; height:0.62em; color:var(--champagne); padding:0 0.2em;
              display:inline-block; vertical-align:middle; transform:translateY(-0.06em);
            }
            .final-names .amp svg{width:100%; height:100%; display:block;}
            .final-date{font-family:var(--font-sc); letter-spacing:0.32em; color:var(--champagne); font-size:1.2rem;}

            footer{
              text-align:center; padding:2.2rem 1rem; font-size:0.75rem; letter-spacing:0.08em; color:var(--ink-soft);
              background:var(--ivory);
            }

            /* ============================================================
               MUSIC TOGGLE
               ============================================================ */
            .music-btn{
              position:fixed; right:clamp(1rem,3vw,2rem); bottom:clamp(1rem,3vw,2rem); z-index:55;
              width:52px; height:52px; border-radius:50%;
              background:rgba(255,255,255,0.7); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);
              border:1px solid var(--champagne-light);
              display:flex; align-items:center; justify-content:center;
              box-shadow:0 10px 30px -12px rgba(59,50,38,0.4);
              transition:transform .35s ease;
            }
            .music-btn:hover{transform:scale(1.06);}
            .music-btn svg{width:20px; height:20px; color:var(--champagne);}
            .music-btn .bars{display:flex; align-items:flex-end; gap:2px; height:16px;}
            .music-btn .bars i{width:2.5px; background:var(--champagne); border-radius:2px; display:block; height:4px;}
            .music-btn.playing .bars i{animation:eq 0.9s ease-in-out infinite;}
            .music-btn .bars i:nth-child(1){animation-delay:0s;}
            .music-btn .bars i:nth-child(2){animation-delay:.15s;}
            .music-btn .bars i:nth-child(3){animation-delay:.3s;}
            @@keyframes eq{0%,100%{height:4px;}50%{height:15px;}}

            /* ============================================================
               FLOATING AMBIENT PETALS
               ============================================================ */
            .petal-field{position:fixed; inset:0; pointer-events:none; z-index:1; overflow:hidden;}
            .petal{
              position:absolute; top:-40px; width:10px; height:10px; opacity:0.5;
              background:var(--champagne-light); border-radius:50% 0 50% 50%;
              animation:fall linear infinite;
            }
            @@keyframes fall{
              to{ transform:translateY(110vh) rotate(200deg); }
            }

            /* ============================================================
               UTILITIES
               ============================================================ */
            .center{text-align:center;}
    </style>
</head>
